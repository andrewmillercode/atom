[package]
name = "ratatex"
version = "0.1.0"
edition = "2024"
rust-version = "1.86"
description = "TeX-quality display math for Ratatui with Kitty Unicode placeholders"
license = "MIT"
repository = "https://github.com/gakonst/ratatex"
homepage = "https://github.com/gakonst/ratatex"
documentation = "https://docs.rs/ratatex"
readme = "README.md"
keywords = ["ratatui", "latex", "terminal", "kitty", "math"]
categories = ["command-line-interface", "rendering"]

[features]
default = ["terminal-probe"]
terminal-probe = ["dep:ratatui-image"]

[dependencies]
base64 = "0.22.1"
crossbeam-channel = "0.5.15"
directories = "6.0.0"
hex = "0.4.3"
image = { version = "0.25.6", default-features = false, features = ["png"] }
# RaTeX publishes its parser, box layout, rasterizer, and shared IR separately.
ratex-layout = "0.1.14"
ratex-parser = "0.1.14"
ratex-render = { version = "0.1.14", features = ["embed-fonts"] }
ratex-types = "0.1.14"
ratatui = { version = "0.29.0", default-features = false }
ratatui-image = { version = "9.0.0", default-features = false, features = ["crossterm"], optional = true }
sha2 = "0.10.9"
tempfile = "3.20.0"
thiserror = "2.0.12"
tracing = "0.1.41"

[dev-dependencies]
color-eyre = "0.6.5"
crossterm = { version = "0.28.1", features = ["event-stream"] }

[[example]]
name = "demo"
path = "examples/demo.rs"
required-features = ["terminal-probe"]

[lints.rust]
unsafe_code = "forbid"

[lints.clippy]
all = { level = "warn", priority = -1 }
pedantic = { level = "warn", priority = -1 }
module_name_repetitions = "allow"
must_use_candidate = "allow"

# The demo is normally launched with `cargo run`, so keep the math
# pipeline optimized even in a debuggable build.
[profile.dev]
opt-level = 1

[profile.dev.package."*"]
opt-level = 3
